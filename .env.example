# ---------------------------------------------------------------------------
# LexiVault environment variables
# Copy to `.env.local` (git-ignored) and fill in real values:
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (public: safe to expose to the browser, protected by RLS) ---
# Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Access control (SERVER-ONLY: never prefix with NEXT_PUBLIC_) ---
# Comma-separated list of emails allowed to sign up, sign in, and call /api/*.
# Strongly recommended before deploying publicly so strangers cannot consume
# your Gemini API quota. Leave blank to allow any authenticated Supabase user.
# Tip: After creating your personal account, also disable public sign-ups in
# Supabase Dashboard -> Authentication -> Sign In / Providers -> User Signups.
ALLOWED_EMAILS=

# --- AI Providers (SERVER-ONLY: configure at least one; Groq is primary) ---
# Primary ultra-fast LPU inference: https://console.groq.com/keys
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Fallback / alternative provider: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite (can override with e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
