# ---------------------------------------------------------------------------
# LexiVault environment variables
# Copy to `.env.local` (git-ignored) and fill in real values:
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (public: safe to expose to the browser, protected by RLS) ---
# Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Gemini (SERVER-ONLY: never prefix with NEXT_PUBLIC_) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
